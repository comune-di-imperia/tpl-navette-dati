# Rapporti periodici e sintesi giornaliera della sperimentazione TPL.
# Va in /etc/cron.d/tpl-navette-rapporti, proprietario root, permessi 0644.
#
# Gli orari sono in ora italiana. Il server tiene l'ora universale, e i timer
# di systemd di questa versione non sanno cambiare fuso: con un orario fisso
# in UTC i messaggi arriverebbero un'ora prima da ottobre a marzo.
CRON_TZ=Europe/Rome
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Lunedi' alle 6: la settimana conclusa, lunedi'-domenica.
0 6 * * 1 tpl /opt/tpl-navette/scripts/tpl_navette/deploy/esegui-cli.sh rapporto-invia --cadenza settimanale 2>&1 | logger -t tpl-rapporto

# Il primo del mese alle 6: il mese concluso.
0 6 1 * * tpl /opt/tpl-navette/scripts/tpl_navette/deploy/esegui-cli.sh rapporto-invia --cadenza mensile 2>&1 | logger -t tpl-rapporto

# Ogni mattina alle 9: la sintesi del giorno prima sui canali Telegram della
# casella. Le giornate senza alcun movimento non generano messaggi.
0 9 * * * tpl /opt/tpl-navette/scripts/tpl_navette/deploy/esegui-cli.sh sintesi-telegram 2>&1 | logger -t tpl-sintesi
