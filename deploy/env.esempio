# /etc/tpl-navette/env  -  proprietario root:tpl, permessi 0640
# Contiene credenziali: NON versionare il file compilato.

# --- applicazione -----------------------------------------------------------
TPL_SECRET_KEY=                 # openssl rand -hex 32 (se cambia, tutti fuori)
TPL_DATI=/var/lib/tpl-navette
TPL_DB=/var/lib/tpl-navette/tpl.sqlite
TPL_MAX_MB=512
TPL_COOKIE_SICURO=1             # 0 solo per prove in HTTP senza certificato
# Finche' non esiste nessun operatore l'app non chiede credenziali e la
# protezione e' il filtro sugli IP del VPS. Creando il primo operatore con
# `cli utente-crea` l'accesso torna obbligatorio da solo; questa variabile
# a 1 lo impone comunque.
TPL_RICHIEDI_ACCESSO=1
# Password degli archivi ZIP cifrati (alcune navette li consegnano protetti
# con cifratura WinZip AES). Va chiesta a chi produce i file.
TPL_ZIP_PASSWORD=
# Indirizzo pubblico usato per comporre i link di recupero password. Deve
# venire da qui e MAI dall'intestazione Host della richiesta, altrimenti chi
# la controlla puo' far generare un link che punta al proprio dominio.
TPL_BASE_URL=https://tpl.comune.imperia.it
PYTHONPATH=/opt/tpl-navette

# --- archiviazione S3 (Huawei OceanStor presso BBBell) ----------------------
# AK/SK dell'object user: SOPS services, device s3-navette-api
S3_ENDPOINT=https://s3.dc01.bbbell.cloud
S3_BUCKET=dati.sperimentazione
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- posta ------------------------------------------------------------------
# OBBLIGATORIA da quando esistono le utenze: senza SMTP non partono ne' gli
# inviti di attivazione ne' i link di recupero password, e l'unico modo di
# creare un utente resta la riga di comando.
# MAIL_TO riguarda solo i report di elaborazione: se vuoto, non si invia nulla.
MAIL_TO=
SMTP_HOST=mail.uno.it
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- statistiche della sperimentazione ------------------------------------
# Lettura dei dati anonimi dall'applicazione dei passeggeri. L'utenza vede
# soltanto le viste `vista_utilizzo`, `vista_ricerca` e `vista_registrazioni`:
# le tabelle con nome, cognome ed email le sono negate dal database stesso.
#
#   CREATE ROLE tpl_statistiche LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE impqr TO tpl_statistiche;
#   GRANT USAGE ON SCHEMA public TO tpl_statistiche;
#   GRANT SELECT ON vista_utilizzo, vista_ricerca, vista_registrazioni
#         TO tpl_statistiche;
TPL_STAT_DB_HOST=127.0.0.1
TPL_STAT_DB_PORT=5432
TPL_STAT_DB_NAME=impqr
TPL_STAT_DB_USER=tpl_statistiche
TPL_STAT_DB_PASSWORD=

# --- rapporti periodici e sintesi giornaliera ------------------------------
# Chi riceve il rapporto settimanale e quello mensile si governa dalla pagina
# delle statistiche, non da qui: l'elenco sta in un file perche' cambia nel
# tempo e lo deve poter cambiare chi amministra il servizio.
TPL_RAPPORTI_DESTINATARI=/var/lib/tpl-navette/destinatari-rapporti.json

# Bot Telegram: lo stesso degli avvisi della casella. La sintesi delle nove va
# ai destinatari Telegram configurati li', per non tenere due elenchi che dopo
# un mese sarebbero diversi.
TPL_TELEGRAM_TOKEN=
TPL_INBOX_DESTINATARI=/var/lib/tpl-inbox-watch/destinatari.json

# La pianificazione sta in deploy/tpl-navette-rapporti.cron: va in
# /etc/cron.d/ e NON fra i timer di systemd, che prima della versione 252 non
# sanno associare un fuso a un orario. Con il server in ora universale gli
# invii slitterebbero di un'ora fra ora legale e solare.
