[Unit]
Description=TPL navette Imperia - caricamento e analisi dati sperimentazione
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tpl
Group=tpl
WorkingDirectory=/opt/tpl-navette
EnvironmentFile=/etc/tpl-navette/env

# UN SOLO worker: la coda di elaborazione vive nel processo. Piu' worker
# significherebbero piu' code indipendenti e stato non condiviso.
# Timeout alto: l'analisi di un archivio da 90 MB richiede decine di secondi.
ExecStart=/opt/tpl-navette/.venv/bin/gunicorn \
    --workers 1 --threads 8 \
    --timeout 900 --graceful-timeout 60 \
    --bind 127.0.0.1:8080 \
    --access-logfile - --error-logfile - \
    scripts.tpl_navette.app:app

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tpl-navette
StateDirectory=tpl-navette

[Install]
WantedBy=multi-user.target
